# Mursen Maintenance — Environment Variables
# Copy this to .env.local for development
# Add these to Vercel project settings for production

# Supabase — see docs/DATABASE.md for how to create a new project
# Project Settings → API in the Supabase dashboard
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Server-side only (DO NOT prefix with VITE_)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-secret-key>

# Resend (get API key from resend.com)
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_EMAIL=hello@mursenmaintenance.com

# Stripe (get keys from stripe.com dashboard)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_ESSENTIAL=price_xxxxxxxx   # $149/mo
STRIPE_PRICE_COMPLETE=price_xxxxxxxx    # $249/mo
STRIPE_PRICE_PREMIUM=price_xxxxxxxx     # $399/mo

# Site URL
SITE_URL=https://mursenmaintenance.com
